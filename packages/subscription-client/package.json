{
  "name": "@push-notification/client",
  "version": "0.0.0",
  "description": "the browser side of @push-notification/server: a Svelte-compatible store of whether an account receives push on this device, and enable / disable",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "delegated-identity": "^0.1.0",
    "sveltore": "^1.0.0"
  },
  "devDependencies": {
    "@libsql/client": "^0.15.15",
    "@noble/secp256k1": "^2.3.0",
    "as-soon": "^0.0.11",
    "prettier": "^3.5.2",
    "@push-notification/server": "workspace:*",
    "remote-sql-libsql": "^0.0.6",
    "typescript": "^5.6.3",
    "viem": "^2.23.5",
    "vitest": "^3.0.7"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "as-soon -w src pnpm build",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest"
  }
}
