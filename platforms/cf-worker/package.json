{
  "name": "@push-notification/cf-worker",
  "version": "0.0.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "src",
    "tsconfig.json"
  ],
  "dependencies": {
    "named-logs": "^0.3.2",
    "named-logs-context": "^0.1.1",
    "@push-notification/server": "workspace:*",
    "remote-sql-d1": "^0.0.6",
    "viem": "^2.23.5",
    "workers-logger": "0.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/node": "^22.13.5",
    "ldenv": "^0.3.12",
    "set-defaults": "^0.0.5",
    "typescript": "^5.6.3",
    "wrangler": "^3.110.0"
  },
  "scripts": {
    "prepare": "set-defaults .",
    "build": "tsc --noEmit -p .",
    "deploy:production": "wrangler -e production deploy --minify",
    "dev": "pnpm init-db && wrangler dev -e production --port 34005",
    "init-db": "ldenv wrangler -e production d1 execute push-notification-db --file=node_modules/@push-notification/server/src/schema/sql/db.sql ~~"
  },
  "license": "AGPL-3.0-only"
}
