# The libSQL database: a file (file:push-notifications.db), a server (libsql://...) or :memory:
DB=file:push-notifications.db
PORT=34005
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# <domain>:<sha256 hex of the token>, comma separated, one per calling service
PUSH_TOKENS=

# This server's public origin, which request signatures name (default: the request URL's)
PUBLIC_ORIGIN=
