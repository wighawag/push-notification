layout {
	pane split_direction="vertical" {
		pane command="bash"  {
			args "-c" "${SHELL-bash}"
		}
	}
	pane split_direction="vertical" {
		pane command="bash"  {
			args "-c" "pnpm subscription-client:dev; cd packages/subscription-client; ${SHELL-bash}"
		}
		pane command="bash"  {
			args "-c" "pnpm example:svelte:dev; cd examples/svelte; ${SHELL-bash}"
		}
	}
	pane split_direction="vertical" {
		pane command="bash"  {
			args "-c" "pnpm server:dev; cd packages/server; ${SHELL-bash}"
		}
		pane name="server sql watch" command="bash" {
			args "-c" "pnpm run --filter ./packages/server sql2ts:watch; cd packages/server; ${SHELL-bash}"
		}
	}
	pane split_direction="vertical" {
		pane name="nodejs build watch" command="bash"  {
			args "-c" "pnpm nodejs:build:watch; cd platforms/nodejs; ${SHELL-bash}"
		}
		pane name="nodejs server" command="bash"  {
			args "-c" "pnpm --filter @push-notification/cli build && pnpm nodejs:dev; cd platforms/nodejs; ${SHELL-bash}"
		}
	}

}
